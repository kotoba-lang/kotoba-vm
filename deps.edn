{:paths ["src"]
 ;; IPLD actor invocation kernel. The only runtime dependency is the
 ;; canonical DAG-CBOR layer: blocks, CIDs, verified reads. Consensus
 ;; (inga) and the codebase evaluator are injected at the seam, never
 ;; imported — a VM that imports a consensus layer becomes that
 ;; consensus layer's VM, and a consensus layer that imports a VM
 ;; cannot run without one.
 ;;
 ;; Filecoin protocol clients (`io-filecoin`, `cloud-filecoin`, Lotus,
 ;; builtin-actors, ref-fvm) are other repos. They do not appear here,
 ;; not even as test extras. Shape is FIP-0030; bytes are not Filecoin's.
 :deps {io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/io-ipld.git"
         :git/sha "8bc2dde5ae47129e49a957131c40313b6b02731c"}
        io.github.kotoba-lang/nio
        {:git/url "https://github.com/kotoba-lang/nio.git"
         :git/sha "0bbbc0501c97a851898bae0e8c634ac135f0cb83"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; The real `:invoke-fn` consumer, here and only here.
                      ;; `src/` must not load it. A bind that only exists in
                      ;; comments is a comment; `vm_inga_bind_test` constructs
                      ;; `inga.state/machine` with `kotoba.vm/invoke-fn`.
                      io.github.kotoba-lang/inga
                      {:git/url "https://github.com/kotoba-lang/inga.git"
                       :git/sha "605c3c92b4a21c0b945b705ba1b3865550b11f78"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
